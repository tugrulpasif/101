{
  "name": "online-101-okey",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,NEXT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:next\"",
    "dev:next": "next dev",
    "dev:server": "tsx watch src/server/server.ts",
    "build": "next build && tsc --project tsconfig.server.json",
    "build:next": "next build",
    "build:server": "tsc --project tsconfig.server.json",
    "start": "node dist/server/server.js",
    "start:next": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "express": "^4.19.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "next": "^14.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.7",
    "typescript": "^5.5.2"
  }
}
